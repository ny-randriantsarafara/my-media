{
  "name": "my-media",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cms:up": "pnpm build:extension && mkdir -p .data/public-media && docker compose up -d --wait",
    "cms:down": "docker compose down",
    "cms:logs": "docker compose logs -f directus",
    "build:extension": "pnpm --filter directus-extension-editorial build",
    "provision": "pnpm --filter @my-media/cms-provision start",
    "test": "python3 -m unittest discover -s deploy/tests -v && pnpm test:workflows && pnpm -r --filter '!@my-media/cms-tests' --if-present test",
    "test:workflows": "node --test deploy/tests/workflows.test.mjs",
    "test:cms": "pnpm --filter @my-media/cms-tests test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:site": "pnpm --filter @my-media/site dev",
    "test:e2e": "pnpm --filter @my-media/site test:e2e",
    "lint:shell": "shellcheck --external-sources deploy/*.sh scripts/ci/*.sh"
  }
}
